{
  "name": "stylelint-plus",
  "version": "2.0.1",
  "displayName": "stylelint-plus",
  "description": "Lint CSS, SCSS, Less and more with Stylelint — auto-fix on save, supports v14-v17, Vue, Svelte, and styled-components.",
  "publisher": "hex-ci",
  "repository": "https://github.com/hex-ci/vscode-stylelint-plus",
  "homepage": "https://github.com/hex-ci/vscode-stylelint-plus#readme",
  "bugs": "https://github.com/hex-ci/vscode-stylelint-plus/issues",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#32CD32",
    "theme": "light"
  },
  "engines": {
    "vscode": ">=1.63.0",
    "node": ">=18.0.0"
  },
  "categories": [
    "Linters",
    "Formatters"
  ],
  "keywords": [
    "stylelint",
    "css",
    "scss",
    "less",
    "autofix"
  ],
  "activationEvents": [
    "onLanguage:css",
    "onLanguage:html",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:less",
    "onLanguage:markdown",
    "onLanguage:postcss",
    "onLanguage:sass",
    "onLanguage:scss",
    "onLanguage:source.css.styled",
    "onLanguage:source.markdown.math",
    "onLanguage:styled-css",
    "onLanguage:sugarss",
    "onLanguage:svelte",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:vue",
    "onLanguage:vue-html",
    "onLanguage:vue-postcss",
    "onLanguage:xml",
    "onLanguage:xsl"
  ],
  "main": "dist/index.js",
  "contributes": {
    "commands": [
      {
        "command": "stylelint.executeAutofix",
        "title": "Fix all auto-fixable problems",
        "category": "Stylelint"
      },
      {
        "command": "stylelint.refreshLocalSearch",
        "title": "Refresh local stylelint search",
        "category": "Stylelint"
      },
      {
        "command": "stylelint.openOutput",
        "title": "Show output channel",
        "category": "Stylelint"
      },
      {
        "command": "stylelint.validateNow",
        "title": "Validate current file",
        "category": "Stylelint"
      },
      {
        "command": "stylelint.lintWorkspace",
        "title": "Lint entire workspace",
        "category": "Stylelint"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "stylelint+ configuration options",
      "properties": {
        "stylelint.enable": {
          "type": "boolean",
          "default": true,
          "description": "Control whether stylelint is enabled for CSS/SCSS/Less files or not."
        },
        "stylelint.config": {
          "type": [
            "object",
            "null"
          ],
          "default": null,
          "description": "A stylelint configuration object."
        },
        "stylelint.useLocal": {
          "type": "boolean",
          "default": false,
          "description": "use local version of stylelint"
        },
        "stylelint.autoFixOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Turns auto fix on save on or off."
        },
        "stylelint.disableErrorMessage": {
          "type": "boolean",
          "default": true,
          "description": "Whether to turn off the display of error messages."
        },
        "stylelint.run": {
          "type": "string",
          "default": "onType",
          "enum": [
            "onType",
            "onSave",
            "manual"
          ],
          "enumDescriptions": [
            "Validate as you type (default)",
            "Validate only when the file is saved",
            "Validate only when manually triggered via command"
          ],
          "description": "Controls when stylelint validation is triggered."
        },
        "stylelint.configFile": {
          "type": "string",
          "default": "",
          "description": "Path to a stylelint configuration file. Relative paths are resolved from the workspace root. Takes precedence over stylelint.config."
        },
        "stylelint.ignorePath": {
          "type": "string",
          "default": "",
          "description": "Path to a .stylelintignore file. Relative paths are resolved from the workspace root. When empty, auto-discovers .stylelintignore by walking up from the document."
        },
        "stylelint.ignoreNodeModules": {
          "type": "boolean",
          "default": true,
          "description": "Whether to skip validation for files inside node_modules directories."
        },
        "stylelint.rules.customizations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "rule": {
                "type": "string",
                "description": "The stylelint rule name."
              },
              "severity": {
                "type": "string",
                "enum": [
                  "error",
                  "warning",
                  "information",
                  "hint",
                  "off"
                ],
                "description": "The severity to override with."
              }
            },
            "required": [
              "rule",
              "severity"
            ],
            "additionalProperties": false
          },
          "default": [],
          "description": "Override the severity of specific stylelint rules. Use 'off' to suppress a rule entirely."
        },
        "stylelint.codeAction.disableRuleComment": {
          "type": "object",
          "properties": {
            "location": {
              "type": "string",
              "enum": [
                "separateLine",
                "sameLine"
              ],
              "default": "separateLine",
              "description": "Where to insert the disable comment."
            }
          },
          "default": {
            "location": "separateLine"
          },
          "description": "Options for the 'Disable rule' code action."
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": "**/.stylelintrc*",
        "url": "http://json.schemastore.org/stylelintrc.json"
      }
    ],
    "languages": [
      {
        "id": "ignore",
        "filenames": [
          ".stylelintignore"
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "lint": "eslint .",
    "clean": "rimraf dist",
    "compile": "node scripts/esbuild.js",
    "compile:watch": "node scripts/esbuild.js --watch",
    "build": "npm run clean && npm run compile",
    "package": "vsce package",
    "pretest": "npm run compile",
    "test": "node scripts/run-test.js",
    "test:unit": "mocha test/unit/*.test.js --exit --timeout 5000",
    "coverage": "nyc --reporter=text --reporter=lcov --reporter=cobertura --reporter=clover --reporter=json npm run test:unit"
  },
  "dependencies": {
    "stylelint": "^15.11.0"
  },
  "peerDependenciesMeta": {
    "stylelint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/vscode": "~1.35.0",
    "@vscode/test-electron": "^2.5.2",
    "array-to-error": "^1.1.1",
    "chai": "^6.2.2",
    "diff": "^8.0.3",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "find-pkg-dir": "^2.0.0",
    "glob": "^13.0.1",
    "inspect-with-kind": "^1.0.5",
    "lodash": "^4.17.23",
    "mocha": "^11.7.5",
    "nyc": "^17.1.0",
    "p-wait-for": "^6.0.0",
    "proxyquire": "^2.1.3",
    "rimraf": "^6.1.2",
    "sinon": "^21.0.1",
    "vscode-languageclient": "^5.2.1",
    "vscode-languageserver": "^5.2.1",
    "vscode-languageserver-types": "^3.17.5",
    "vscode-uri": "^3.1.0"
  }
}
