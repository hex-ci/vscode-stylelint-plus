{
  "name": "stylelint-plus",
  "version": "1.2.0",
  "displayName": "stylelint-plus",
  "description": "Modern CSS/SCSS/Less linter for vscode, support auto fix on save.",
  "publisher": "hex-ci",
  "repository": "https://github.com/hex-ci/vscode-stylelint-plus",
  "homepage": "https://github.com/hex-ci/vscode-stylelint-plus#readme",
  "bugs": "https://github.com/hex-ci/vscode-stylelint-plus/issues",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#32CD32",
    "theme": "light"
  },
  "engines": {
    "vscode": ">=1.35.0",
    "node": ">=20.0.0"
  },
  "categories": [
    "Linters"
  ],
  "keywords": [
    "lint",
    "style",
    "stylelint",
    "validation",
    "check"
  ],
  "activationEvents": [
    "onLanguage:css",
    "onLanguage:html",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:less",
    "onLanguage:markdown",
    "onLanguage:postcss",
    "onLanguage:sass",
    "onLanguage:scss",
    "onLanguage:source.css.styled",
    "onLanguage:source.markdown.math",
    "onLanguage:styled-css",
    "onLanguage:sugarss",
    "onLanguage:svelte",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:vue",
    "onLanguage:vue-html",
    "onLanguage:vue-postcss",
    "onLanguage:xml",
    "onLanguage:xsl"
  ],
  "main": "dist/index.js",
  "contributes": {
    "commands": [
      {
        "command": "stylelint.executeAutofix",
        "title": "Fix all auto-fixable problems",
        "category": "Stylelint"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "stylelint+ configuration options",
      "properties": {
        "stylelint.enable": {
          "type": "boolean",
          "default": true,
          "description": "Control whether stylelint is enabled for CSS/SCSS/Less files or not."
        },
        "stylelint.config": {
          "type": [
            "object",
            "null"
          ],
          "default": null,
          "description": "A stylelint configuration object."
        },
        "stylelint.configOverrides": {
          "type": [
            "object",
            "null"
          ],
          "default": null,
          "description": "A partial stylelint config whose properties override the existing ones."
        },
        "stylelint.useLocal": {
          "type": "boolean",
          "default": false,
          "description": "use local version of stylelint"
        },
        "stylelint.autoFixOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Turns auto fix on save on or off."
        },
        "stylelint.disableErrorMessage": {
          "type": "boolean",
          "default": true,
          "description": "Whether to turn off the display of error messages."
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": "**/.stylelintrc*",
        "url": "http://json.schemastore.org/stylelintrc.json"
      }
    ],
    "languages": [
      {
        "id": "ignore",
        "filenames": [
          ".stylelintignore"
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "lint": "eslint .",
    "clean": "rimraf dist",
    "compile": "node scripts/esbuild.js",
    "compile:watch": "node scripts/esbuild.js --watch",
    "build": "npm run clean && npm run compile",
    "package": "vsce package",
    "pretest": "npm run compile",
    "test": "node scripts/run-test.js",
    "test:unit": "mocha test/unit/*.test.js --exit --timeout 5000",
    "coverage": "nyc --reporter=text --reporter=lcov --reporter=cobertura --reporter=clover --reporter=json npm run test:unit"
  },
  "dependencies": {
    "stylelint": "^15.11.0"
  },
  "peerDependenciesMeta": {
    "stylelint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/vscode": "~1.35.0",
    "@vscode/test-electron": "^2.5.2",
    "array-to-error": "^1.1.1",
    "chai": "^6.2.2",
    "diff": "^8.0.3",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "find-pkg-dir": "^2.0.0",
    "glob": "^13.0.0",
    "inspect-with-kind": "^1.0.5",
    "lodash": "^4.17.23",
    "mocha": "^11.7.5",
    "nyc": "^17.1.0",
    "p-wait-for": "^6.0.0",
    "proxyquire": "^2.1.3",
    "rimraf": "^6.1.2",
    "sinon": "^21.0.1",
    "vscode-languageclient": "^5.2.1",
    "vscode-languageserver": "^5.2.1",
    "vscode-languageserver-types": "^3.17.5",
    "vscode-uri": "^3.1.0"
  }
}
