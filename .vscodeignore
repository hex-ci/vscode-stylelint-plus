# Ignore everything, then whitelist what we need
**

# Bundled output
!dist/**/*.js

# Production dependencies (resolved by vsce)
!node_modules/**

# Localization
!l10n/**
!package.nls.json
!package.nls.zh-cn.json

# Package metadata
!package.json
!README.md
!README.zh-CN.md
!LICENSE
!CHANGELOG.md
!media/icon.png
